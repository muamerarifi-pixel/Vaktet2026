<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="7dp"
        android:contentDescription="Vaktet"
        android:src="@drawable/ic_stat_vaktet"
        android:tint="#FCE6B0" />

    <TextView
        android:id="@+id/widget_prayer_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:shadowColor="#88000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:text="Vaktet"
        android:textColor="#F0FFFFFF"
        android:textSize="14sp"
        android:fontFamily="sans-serif" />

    <TextView
        android:id="@+id/widget_sep"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:shadowColor="#88000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:text="•"
        android:textColor="#88FFFFFF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_remaining"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:shadowColor="#88000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:text="—"
        android:textColor="#FFF4D2"
        android:textSize="15sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium" />

</LinearLayout>
